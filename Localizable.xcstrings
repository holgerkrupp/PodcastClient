      }
    },
    "There is no current podcast episode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine aktuelle Podcast-Episode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas d'épisode de podcast actuel."
          }
