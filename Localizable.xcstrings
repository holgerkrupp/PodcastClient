    "Uniform color" : {

    },
    "Unknown duration, publication date, or episode type passes that check. Manual downloads always work. Playlist auto-downloads inherit these rules; matching rules never change queue membership or remove files already downloaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte Dauer, unbekanntes Veröffentlichungsdatum oder unbekannter Episodentyp bestehen diese Prüfung. Manuelle Downloads sind immer möglich. Automatische Downloads von Wiedergabelisten übernehmen diese Regeln. Übereinstimmende Regeln ändern weder die Warteschlange noch entfernen sie bereits geladene Dateien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les passes de vérification dont la durée, la date de publication ou le type d'épisode sont inconnus fonctionnent toujours avec les téléchargements manuels. Les téléchargements automatiques de la playlist héritent de ces règles ; les règles de correspondance ne modifient jamais l'adhésion à la file d'attente ou suppriment les fichiers déjà téléchargés."
          }
        }
      }
    },
    "Unsubscribe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht mehr abonnieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "se désabonner"
          }
        }
      }
    },
