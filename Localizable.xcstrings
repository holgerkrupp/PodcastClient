    },
    "There is no episode playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird keine Episode wiedergegeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas d'épisode en cours de lecture."
          }
        }
      }
    },
    "These chapter rules could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kapitelregeln konnten nicht geladen werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces règles de chapitre n'ont pas pu être chargées."
          }
        }
      }
    },
    "These durations are used by the app player, shortcuts, and any external controls set to seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dauern werden vom App-Player, von Kurzbefehlen und von allen externen Steuerungen verwendet, die auf Sekunden eingestellt sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces durées sont utilisées par l’application de lecture, les raccourcis et tous les contrôles externes réglés sur des secondes."
          }
        }
      }
    },
    "These feeds returned an error code and are skipped when subscribing to all new podcasts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Feeds haben einen Fehlercode zurückgegeben und werden beim Abonnieren aller neuen Podcasts übersprungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces flux ont renvoyé un code d'erreur et sont sautés lors de l'abonnement à tous les nouveaux podcasts."
          }
        }
      }
    },
    "These package-level phases describe the latest CloudKit event from any store. Store convergence is reported above." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Phasen auf Paketebene beschreiben das jüngste CloudKit-Ereignis aus einem beliebigen Datenspeicher. Der Abgleich der Datenspeicher wird oben angezeigt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces phases au niveau du paquet décrivent le dernier événement CloudKit de n'importe quelle boutique. La convergence des boutiques est signalée ci-dessus."
          }
        }
      }
    },
    "These values apply across the app unless a podcast is switched to custom settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Werte gelten in der gesamten App, sofern ein Podcast nicht auf Individuell umgestellt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces valeurs s’appliquent à l’ensemble de l’application, sauf si un podcast est basculé dans des paramètres personnalisés."
          }
        }
      }
    },
    "This app plays spoken-word audio and does not include separate audio-description tracks. Chapter titles and transcripts provide descriptive context instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App spielt gesprochenes Audio ab und enthält keine separaten Audiobeschreibungsspuren. Stattdessen liefern Kapiteltitel und Transkripte beschreibenden Kontext."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application joue de l'audio parlé et n'inclut pas de pistes audio-description séparées. Les titres de chapitres et les transcriptions fournissent plutôt un contexte descriptif."
          }
        }
      }
    },
    "This broadcaster does not offer that." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Sender bietet das nicht an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce diffuseur n'offre pas cela."
          }
        }
      }
    },
    "This broadcaster is not available in this build." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Sender ist in dieser Version nicht verfügbar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce diffuseur n'est pas disponible dans cette version."
          }
        }
      }
    },
    "This episode cannot be downloaded by Up Next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Episode kann nicht mit „Als Nächstes“ geladen werden."
