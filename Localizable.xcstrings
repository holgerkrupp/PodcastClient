          }
        }
      }
    },
    "Automatic Episode Skips" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Episodensprünge"
          }
        }
      }
    },
    "Automatic for Period" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch für Zeitraum"
          }
        }
      }
    },
    "Automatic for Period picks the background from the data period, not from the day the shortcut runs. A shortcut running on 1 June with Previous Period uses May’s background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch für Zeitraum“ wählt den Hintergrund anhand des Datenzeitraums aus, nicht anhand des Tages, an dem der Kurzbefehl ausgeführt wird. Ein Kurzbefehl, der am 1. Juni mit „Vorheriger Zeitraum“ ausgeführt wird, verwendet den Mai-Hintergrund."
          }
        }
      }
    },
    "Automatic on-device transcriptions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatische Transkriptionen auf dem Gerät"
          }
        }
      }
    },
    "Automatic skipping applies to every transcript-gap chapter. Review their boundaries in the chapter list; you can also skip individual chapters there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das automatische Überspringen gilt für alle Transkriptlücken-Kapitel. Überprüfe ihre Grenzen in der Kapitelliste; dort kannst du auch einzelne Kapitel überspringen."
          }
        }
      }
    },
    "Automatically generate chapters when publisher chapters are unavailable" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapitel automatisch erstellen, wenn der Herausgeber keine Kapitel bereitstellt"
          }
        }
      }
    },
    "Automatically skip high-confidence advertisements" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werbung mit hoher Erkennungssicherheit automatisch überspringen"
          }
        }
      }
    },
    "Automatically skip transcript-gap chapters" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkriptlücken-Kapitel automatisch überspringen"
          }
        }
      }
    },
    "Automatically start the next queue item when an episode finishes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte automatisch den nächsten Eintrag in der Warteschlange, wenn eine Episode endet."
          }
        }
      }
    },
    "Automatically synchronize publisher transcripts" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripte des Herausgebers automatisch synchronisieren"
          }
        }
      }
    },
    "Available actions now include: Resume Playback, Pause Playback, Bookmark This, Skip Forward, Skip Backward, Play Up Next, Play Next Up Next Episode, Move Current To End, Remove Current From Up Next, Refresh Podcasts, and Generate Podcast Share Image." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbare Aktionen sind jetzt: Wiedergabe fortsetzen, Wiedergabe anhalten, Lesezeichen setzen, Vorwärtsspringen, Zurückspringen, „Als Nächstes“ abspielen, nächste „Als Nächstes“-Episode abspielen, aktuelle Episode ans Ende verschieben, aktuelle Episode aus „Als Nächstes“ entfernen, Podcasts aktualisieren und Podcast-Teilen-Bild erstellen."
          }
        }
      }
    },
