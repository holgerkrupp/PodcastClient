    "Reduce tracking in network requests" : {

    },
    "Reduced Motion, Larger Text, and Differentiate Without Color are supported. If you use high contrast settings, the app increases secondary text contrast in now-playing interfaces." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“, größerer Text und „Ohne Farbe differenzieren“ werden unterstützt. Wenn du hohen Kontrast verwendest, erhöht die App in „Jetzt läuft“-Ansichten den Kontrast sekundärer Texte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réduction du mouvement, le texte plus grand et la différenciation sans couleur sont pris en charge. Si vous utilisez des paramètres de contraste élevés, l'application augmente le contraste du texte secondaire dans les interfaces en cours de lecture."
          }
        }
      }
    },
    "Reduction level" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduktionsstufe"
