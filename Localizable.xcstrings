    },
    "The progress bar compares this device's local SwiftData record count with a lightweight reference shared through iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fortschrittsbalken vergleicht die lokale Anzahl der SwiftData-Datensätze dieses Geräts mit einer einfachen Referenz, die über iCloud geteilt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre de progression compare le nombre de registres SwiftData locaux de cet appareil avec une référence légère partagée via iCloud."
          }
        }
      }
    },
    "The saved credentials were rejected. Check the username and password." : {
      "localizations" : {
        "de" : {
