          }
        }
      }
    },
    "Keeps the first episodes of this playlist downloaded, in playlist order. Later episodes download as the ones above them leave the playlist. Downloads already on this device are never deleted by this setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die ersten Episoden dieser Wiedergabeliste in der Reihenfolge der Liste geladen. Weitere Episoden werden geladen, sobald die Episoden über ihnen die Liste verlassen. Bereits geladene Dateien werden durch diese Einstellung nie gelöscht."
