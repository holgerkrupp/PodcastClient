    "Unexpectedly idle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unerwartet inaktiv"
          }
        }
      }
    },
    "Unknown duration, publication date, or episode type passes that check. Manual downloads always work. Playlist auto-downloads inherit these rules; matching rules never change queue membership or remove files already downloaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte Dauer, unbekanntes Veröffentlichungsdatum oder unbekannter Episodentyp bestehen diese Prüfung. Manuelle Downloads sind immer möglich. Automatische Downloads von Wiedergabelisten übernehmen diese Regeln. Übereinstimmende Regeln ändern weder die Warteschlange noch entfernen sie bereits geladene Dateien."
          }
        }
      }
    },
    "Unsubscribe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht mehr abonnieren"
          }
        }
      }
    },
    "Up Next" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes"
          }
        }
      }
    },
    "Up Next actions are available in Apple Shortcuts. Search for “Up Next” when adding an action to a shortcut or personal automation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up Next-Aktionen sind in Apple Kurzbefehle verfügbar. Suche beim Hinzufügen einer Aktion zu einem Kurzbefehl oder einer persönlichen Automation nach „Up Next“."
          }
        }
      }
    },
    "Up Next Basics" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundlagen von „Als Nächstes“"
          }
        }
      }
    },
    "Up Next could not open its library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up Next konnte seine Mediathek nicht öffnen."
          }
        }
      }
    },
    "Up Next is empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ ist leer."
          }
        }
      }
    },
    "Up Next is starting" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ wird gestartet"
          }
        }
      }
    },
    "Up Next is unavailable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ ist nicht verfügbar."
          }
        }
      }
    },
    "Up Next is your single playback queue. Episodes in this list are what the player uses for \"what comes next.\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ ist deine zentrale Wiedergabewarteschlange. Episoden in dieser Liste verwendet der Player für das, was als Nächstes kommt."
          }
        }
      }
    },
    "Up Next supports subscriber-specific RSS links and standards-based HTTP authentication. Provider websites are never scraped, and a provider password is never requested unless an official account adapter is added." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ unterstützt abonnentenspezifische RSS-Links und standardisierte HTTP-Authentifizierung. Anbieter-Websites werden niemals ausgelesen und Anbieterpasswörter nur abgefragt, wenn eine offizielle Kontoanbindung hinzugefügt wird."
          }
        }
      }
    },
    "Up Next Watch" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Als Nächstes“ Watch"
          }
        }
      }
    },
