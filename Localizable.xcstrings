            "value" : "Gefunden im Apple-Podcasts-Katalog."
          }
        }
      }
    },
    "French-language radio and podcasts from SRG SSR." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Französischsprachiges Radio und Podcasts der SRG SSR."
          }
        }
      }
    },
    "From %@ to %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von %1$@ bis %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From %1$@ to %2$@"
          }
        }
      }
    },
    "Gap chapters are added only after multiple confident matches identify inserted audio. They may be ads or other audio absent from the publisher transcript." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lücken-Kapitel werden erst hinzugefügt, wenn mehrere zuverlässige Übereinstimmungen eingefügtes Audio erkennen. Dabei kann es sich um Werbung oder anderes Audio handeln, das im Verlags-Transkript fehlt."
          }
        }
      }
    },
    "Generate a Podcast Share Image" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-Bild zum Teilen erstellen"
          }
        }
      }
    },
    "Generate a transcript and use it to create chapter markers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Transkript erstellen und daraus Kapitelmarkierungen erzeugen."
          }
        }
      }
    },
    "Generate a transcript to read along with this episode." : {
      "localizations" : {
        "de" : {
