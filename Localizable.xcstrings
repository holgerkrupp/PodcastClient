    },
    "URL" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL"
          }
        }
      }
    },
    "URL or Search" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL oder Suche"
          }
        }
      }
    },
    "Use \"Only while charging\" if you want automatic local transcription to wait for external power. While the app is open it reacts to charging changes, and in the background it works through your playlists whenever the device has a free moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „Nur während des Ladevorgangs“, wenn die automatische lokale Transkription auf externe Stromversorgung warten soll. Während die App geöffnet ist, reagiert sie auf Ladeänderungen. Im Hintergrund arbeitet sie deine Playlists ab, sobald das Gerät einen freien Moment hat."
          }
        }
      }
    },
    "Use a private RSS link or authenticated feed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privaten RSS-Link oder authentifizierten Feed verwenden"
          }
        }
      }
    },
    "Use at least %lld characters to search transcripts." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende mindestens %lld Zeichen, um Transkripte zu durchsuchen."
          }
        }
      }
    },
    "Use Custom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individuell verwenden"
          }
        }
      }
    },
    "Use global rules for all podcasts, or enable custom settings for one podcast when it needs its own behavior." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende globale Regeln für alle Podcasts oder aktiviere eigene Einstellungen für einen Podcast, wenn er eigenes Verhalten benötigt."
          }
        }
      }
    },
    "Use podcast-specific settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podcast-spezifische Einstellungen verwenden"
          }
        }
      }
    },
    "Use previous and next week buttons to change the date range" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Tasten für die vorherige und nächste Woche, um den Datumsbereich zu ändern."
          }
        }
      }
    },
    "Use rules for repeated segments like ads, intros, and credits. Each rule checks the chapter title with a match style such as contains or starts with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende Regeln für wiederkehrende Segmente wie Werbung, Intros und Abspann. Jede Regel prüft den Kapiteltitel mit einem Übereinstimmungsstil wie „enthält“ oder „beginnt mit“."
          }
        }
      }
    },
    "Use the chapter row to generate a transcript on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Kapitelzeile, um auf diesem Gerät ein Transkript zu erstellen."
          }
        }
      }
    },
    "Use the chapter row to generate chapters on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Kapitelzeile, um auf diesem Gerät Kapitel zu erstellen."
          }
        }
      }
    },
    "Use the configured skip intervals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die festgelegten Sprungintervalle verwenden."
          }
        }
      }
    },
    "Use the iOS/macOS 27 Audio App Schema for playlist additions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Audio App Schema von iOS/macOS 27 zum Hinzufügen zu Wiedergabelisten verwenden."
          }
        }
      }
    },
    "Use this only when no other device is using the legacy library sync. This one-way change keeps the local library and User State sync, but the old library will no longer exchange updates with other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur verwenden, wenn kein anderes Gerät die Synchronisierung der alten Mediathek nutzt. Bei dieser einmaligen Änderung werden die lokale Mediathek und der Benutzerstatus weiterhin synchronisiert; die alte Mediathek tauscht jedoch keine Aktualisierungen mehr mit anderen Geräten aus."
          }
        }
      }
    },
    "Use transcript text as a Shortcuts file or request the existing transcription pipeline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripttext als Kurzbefehlsdatei verwenden oder die bestehende Transkription anfordern."
          }
        }
      }
    },
    "Use Up Next's existing transcript import or on-device transcription pipeline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den vorhandenen Transkriptimport oder die Transkription auf dem Gerät von „Als Nächstes“ verwenden."
          }
        }
      }
    },
    "Used when playback starts; the player speed control updates this value." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird beim Start der Wiedergabe verwendet; die Geschwindigkeitssteuerung des Players aktualisiert diesen Wert."
          }
        }
      }
    },
    "Useful Outputs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nützliche Ausgaben"
          }
        }
      }
    },
    "User State authority" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "User State als führende Datenquelle"
          }
        }
      }
    },
    "User State queue entries: %lld → %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge der Benutzerstatus-Warteschlange: %lld → %lld"
