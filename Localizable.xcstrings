    "%lld file%@ (%@) are currently protected because their episodes are in Up Next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Datei%2$@ (%3$@) sind derzeit geschützt, weil sich die zugehörigen Episoden in „Als Nächstes“ befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld file%2$@ (%3$@) are currently protected because their episodes are in Up Next."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichier %lld%@ (%@) sont actuellement protégés car leurs épisodes sont dans Up Next."
          }
        }
      }
    },
    "%lld file%@ (%@) are currently protected by archive retention settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Datei%2$@ (%3$@) sind derzeit durch die Archiv-Aufbewahrung geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld file%2$@ (%3$@) are currently protected by archive retention settings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier %lld%@ (%@) est actuellement protégé par les paramètres de conservation des archives."
          }
        }
      }
    },
    "%lld file%@ (%@) can be removed without deleting downloads needed for Up Next or archived episodes still inside their retention window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Datei%2$@ (%3$@) können entfernt werden, ohne Downloads zu löschen, die für „Als Nächstes“ benötigt werden oder noch innerhalb der Archiv-Aufbewahrung liegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld file%2$@ (%3$@) can be removed without deleting downloads needed for Up Next or archived episodes still inside their retention window."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier %lld%@ (%@) peut être supprimé sans supprimer les téléchargements nécessaires pour Up Next ou les épisodes archivés encore dans leur fenêtre de conservation."
          }
        }
      }
    },
