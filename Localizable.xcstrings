        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur de barre de menu est temporairement désactivé sur cette version de macOS afin d’éviter un bouclier de lancement."
          }
        }
      }
    },
    "The podcast and its listening history remain in your library. Only the secure credential is removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Podcast und sein Hörverlauf bleiben in deiner Mediathek. Nur die sicher gespeicherten Zugangsdaten werden entfernt."
